{
  "name": "menu-maestro",
  "private": true,
  "type": "module",
  "workspaces": ["frontend", "backend"],
  "engines": { "node": ">=22.12" },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:fe": "npm run dev --workspace frontend",
    "dev:be": "npm run dev --workspace backend",
    "build": "npm run build --workspace frontend",
    "typecheck": "npm run typecheck --workspace frontend",
    "lint": "npm run lint --workspace frontend && npm run lint --workspace backend",
    "test": "npm run test --workspace backend",
    "start": "npm run start --workspace backend"
  }
}
